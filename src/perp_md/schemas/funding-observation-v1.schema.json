{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:perp-md:schema:funding-observation:1",
  "title": "perp-md funding observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "sample", "provider_evidence"],
  "properties": {
    "schema_id": {"const": "urn:perp-md:schema:funding-observation:1"},
    "sample": {"$ref": "urn:cdm:schema:funding-sample:1"},
    "provider_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_observation", "retrieved_at"],
      "properties": {
        "source_observation": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{6})?Z(?![\\s\\S])"
        },
        "source_value": {
          "type": "string",
          "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))(?![\\s\\S])"
        },
        "mark_price": {
          "type": "string",
          "pattern": "^(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?)(?![\\s\\S])"
        }
      }
    }
  }
}
